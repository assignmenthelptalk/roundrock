---
import { site } from "../lib/site";
---

<section class="map-section-wrapper">
  <div class="map-section-inner">

    <div class="map-section-header">
      <h2>{site.city} Neighbourhood Water Hardness</h2>
      <p>Every pin below reflects the same {site.gpgLow}-{site.gpgHigh} GPG reading {site.waterAuthority} reports citywide, per its own service data. Click a neighbourhood to see its full hardness report and get a free quote for your address.</p>
    </div>

    <div class="map-panel">

      <!-- Left: map -->
      <div class="map-left">
        <div id="roundrock-map"></div>
        <div class="map-legend">
          <span class="legend-selected">● Selected Area</span>
          <span class="legend-available">○ Available Data</span>
        </div>
      </div>

      <!-- Right: report panel -->
      <div class="map-right" id="neighbourhood-report">

        <div class="report-header">
          ⚡ Neighbourhood Report
        </div>

        <div class="report-body">
          <!-- Default state — no neighbourhood selected -->
          <div class="report-default" id="report-default">
            <p>Select a neighbourhood on the map to see its hardness report.</p>
          </div>

          <!-- Active state — neighbourhood selected (hidden until click) -->
          <div class="report-active" id="report-active" style="display:none">
            <div class="report-field">
              <span class="field-label">NEIGHBOURHOOD</span>
              <span class="field-value" id="report-name"></span>
            </div>
            <div class="report-field">
              <span class="field-label">HARDNESS LEVEL</span>
              <div class="gpg-row">
                <span class="gpg-number" id="report-gpg"></span>
                <span class="gpg-unit">GPG</span>
                <span class="gpg-badge">{site.gpgLabel.toUpperCase()}</span>
              </div>
            </div>
            <div class="report-wqa" id="report-wqa"></div>
            <div class="report-issues-wrapper">
              <p class="issues-heading" id="report-issues-heading"></p>
              <ul class="report-issues" id="report-issues"></ul>
            </div>
            <a href="/quote/" class="report-cta" id="report-cta">
              Get a Free Water Softener Quote in {site.city}
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Section wrapper */
  .map-section-wrapper {
    padding: 80px 24px;
    background: var(--surface-elevated);
  }
  .map-section-inner { max-width: 1200px; margin: 0 auto; }
  .map-section-header { text-align: center; margin-bottom: 40px; }
  .map-section-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 42px);
    letter-spacing: -0.03em;
    color: var(--surface-footer);
  }
  .map-section-header p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  /* Split panel */
  .map-panel {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 24px;
    align-items: start;
  }

  /* Map container */
  .map-left { position: relative; }
  #roundrock-map {
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(27,58,107,0.15);
    background: var(--surface-footer);
  }
  /* Recolors keyless OpenStreetMap raster tiles to match the navy/gold theme —
     scoped to the tile pane only (not markers/popups/controls), which are
     separate sibling panes in Leaflet's DOM and so stay unaffected. */
  :global(#roundrock-map .leaflet-tile-pane) {
    filter: invert(1) hue-rotate(190deg) brightness(1.18) contrast(0.85) saturate(0.65);
  }

  /* Map legend */
  .map-legend {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(27,58,107,0.85);
    backdrop-filter: blur(4px);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 1000;
  }
  .legend-selected {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent-dark);
  }
  .legend-available {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.60);
  }

  /* Pin styles */
  :global(.map-pin-default) {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.50);
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
  }
  :global(.map-pin-default:hover) {
    border-color: white;
    background: rgba(255,255,255,0.28);
    transform: scale(1.15);
  }
  :global(.map-pin-active) {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 3px solid white;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
  }
  :global(.map-pin-pulse) {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: rgba(27,58,107,0.20);
    animation: pin-pulse 2s ease-out infinite;
  }
  @keyframes pin-pulse {
    0%   { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2); opacity: 0; }
  }

  /* Map label popup */
  :global(.map-label-popup .leaflet-popup-content-wrapper) {
    background: white;
    border-radius: 20px;
    padding: 0;
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }
  :global(.map-label-popup .leaflet-popup-content) {
    margin: 8px 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: #111827;
  }
  :global(.map-label-popup .leaflet-popup-tip) {
    background: white;
  }

  /* Hover tooltip — overrides Leaflet default styling */
  :global(.map-tooltip-wrapper) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  :global(.map-tooltip-wrapper::before) {
    display: none !important;
  }
  :global(.map-hover-tooltip) {
    background: white;
    border-radius: 10px;
    padding: 10px 14px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25),
                0 1px 4px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 120px;
    text-align: center;
  }
  :global(.tooltip-name) {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    color: #111827;
    white-space: nowrap;
  }
  :global(.tooltip-gpg) {
    font-family: var(--font-body);
    font-size: 12px;
    color: #6B7280;
    font-weight: 500;
  }

  /* Report panel */
  .map-right {
    background: var(--surface-base);
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    position: sticky;
    top: 80px;
  }
  .report-header {
    background: var(--color-primary);
    color: white;
    padding: 16px 20px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .report-body { padding: 24px; }
  .report-default {
    color: #9CA3AF;
    font-family: var(--font-body);
    font-size: 14px;
    text-align: center;
    padding: 32px 16px;
    line-height: 1.6;
  }
  .report-field { margin-bottom: 20px; }
  .field-label {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #9CA3AF;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .field-value {
    font-family: var(--font-heading);
    font-size: 22px;
    color: #111827;
    display: block;
  }
  .gpg-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .gpg-number {
    font-family: var(--font-heading);
    font-size: 48px;
    color: #111827;
    line-height: 1;
  }
  .gpg-unit {
    font-family: var(--font-body);
    font-size: 18px;
    color: #6B7280;
    font-weight: 500;
  }
  .gpg-badge {
    padding: 4px 12px;
    border-radius: 20px;
    background: #FEE2E2;
    color: #991B1B;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .wqa-note {
    background: var(--color-primary-light);
    border-radius: 8px;
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-primary);
    line-height: 1.6;
    margin-bottom: 20px;
    font-style: italic;
  }
  .issues-heading {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .report-issues {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .report-issues li {
    font-family: var(--font-body);
    font-size: 13px;
    color: #6B7280;
    padding: 8px 0;
    border-bottom: 1px solid #F3F4F6;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }
  .report-issues li:last-child { border-bottom: none; }
  .report-issues li::before {
    content: '•';
    color: var(--color-accent);
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .report-cta {
    display: block;
    padding: 13px 20px;
    background: var(--color-accent);
    color: white;
    text-align: center;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(200,155,60,0.30);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .report-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(200,155,60,0.40);
  }
  .report-cta:active {
    transform: translateY(0);
  }
  .report-cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .map-panel {
      grid-template-columns: 1fr;
    }
    .map-right {
      order: -1;
      position: static;
    }
    #roundrock-map { height: 320px; }
    .map-section-wrapper { padding: 48px 16px; }
  }
</style>

<script>
  import L from "leaflet";

  interface Neighbourhood {
    name: string;
    coords: [number, number];
    gpgRange: string;
    classification: string;
    description: string;
    wqaNote: string;
    issues: string[];
  }

  // MAP_CONFIG — Round Rock, TX
  // Pin coordinates come from OpenStreetMap (Nominatim) place and landuse
  // records for each neighbourhood. The map is static (no zoom or pan), and
  // frames itself once around the pins, so no centre, zoom, or bounds config
  // is needed.

  const neighbourhoods: Neighbourhood[] = [
    {
      name: "Teravista",
      coords: [30.571, -97.6717],
      gpgRange: "11–15",
      classification: "VERY HARD",
      description:
        "A newer-construction master-planned community in northeast Round Rock built around Teravista Golf Club. Tankless and tank water heaters in these homes run daily, so scale builds on their heat exchangers and elements.",
      wqaNote: 'Anything above 10.5 GPG is considered "Very Hard" by the Water Quality Association.',
      issues: [
        "Scale buildup on tankless water heater heat exchangers, cutting efficiency",
        "Mineral spotting on large glass shower doors and stone countertops",
        "White crust on irrigation heads watering golf-course-adjacent lawns",
        "Shorter dishwasher and washing machine lifespan from daily scale exposure",
      ],
    },
    {
      name: "Paloma Lake",
      coords: [30.5589, -97.6226],
      gpgRange: "11–15",
      classification: "VERY HARD",
      description:
        "A master-planned community in east Round Rock with amenity centres, pools, and trails. Newer homes here often include multiple bathrooms and appliances that scale shortens the life of.",
      wqaNote: 'Anything above 10.5 GPG is considered "Very Hard" by the Water Quality Association.',
      issues: [
        "Scale deposits across multiple bathrooms' faucets and showerheads",
        "Chalky film on community-pool-adjacent patio fixtures and outdoor spigots",
        "Water heater efficiency loss as mineral scale insulates heating elements",
        "Spotted glassware and dishes from hard-water dishwasher cycles",
      ],
    },
    {
      name: "Forest Creek",
      coords: [30.5086, -97.5943],
      gpgRange: "11–15",
      classification: "VERY HARD",
      description:
        "An established golf-course community in Round Rock with larger custom homes around Forest Creek Golf Club. Bigger homes mean more fixtures, longer pipe runs, and more appliances exposed to hard water.",
      wqaNote: 'Anything above 10.5 GPG is considered "Very Hard" by the Water Quality Association.',
      issues: [
        "Scale across long supply-line runs in larger custom homes",
        "Mineral staining on high-end faucets, tubs, and designer fixtures",
        "Reduced water pressure from scale narrowing older pipe sections",
        "Water-spotted cars and windows from irrigation overspray on hard water",
      ],
    },
    {
      name: "Behrens Ranch",
      coords: [30.538, -97.7235],
      gpgRange: "11–15",
      classification: "VERY HARD",
      description:
        "A northwest Round Rock neighbourhood known for larger lots and hilltop views. Lawn and landscape irrigation on bigger properties puts more hard water onto surfaces and equipment.",
      wqaNote: 'Anything above 10.5 GPG is considered "Very Hard" by the Water Quality Association.',
      issues: [
        "White mineral staining on exterior walls and windows from irrigation spray",
        "Scale on irrigation valves and sprinkler heads across larger lots",
        "Scale buildup inside water heaters serving bigger households",
        "Soap scum and dry skin from hard water in every bathroom",
      ],
    },
    {
      name: "Sonoma",
      coords: [30.5067, -97.6278],
      gpgRange: "11–15",
      classification: "VERY HARD",
      description:
        "A southeast Round Rock community with a neighbourhood lake and HOA park. Homeowners here share the same 11-15 GPG city supply as the rest of Round Rock, so scale shows up in every home.",
      wqaNote: 'Anything above 10.5 GPG is considered "Very Hard" by the Water Quality Association.',
      issues: [
        "Scale buildup on faucets, showerheads, and aerators",
        "Dingy, stiff laundry from mineral deposits in washing machine cycles",
        "Mineral film on dishes and glassware straight out of the dishwasher",
        "Reduced water heater lifespan from scale on the heating elements",
      ],
    },
  ];

  function defaultIcon(): L.DivIcon {
    return L.divIcon({
      className: "map-pin-wrapper",
      html: '<div class="map-pin-default"></div>',
      iconSize: [22, 22],
      iconAnchor: [11, 11],
      popupAnchor: [0, -14],
    });
  }

  function activeIcon(): L.DivIcon {
    return L.divIcon({
      className: "map-pin-wrapper",
      html: `<div class="map-pin-active">
               <span class="map-pin-pulse"></span>
               <svg viewBox="0 0 24 24" width="14" height="14" fill="white">
                 <path d="M13 2L4.09 12.26h6.65L9.61 22 20 11.74h-6.65z"/>
               </svg>
             </div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
      popupAnchor: [0, -18],
    });
  }

  const mapEl = document.getElementById("roundrock-map");

  if (mapEl) {
    // Static map: no zoom controls, wheel/touch/double-click zoom, or panning.
    // The view is framed once around the neighbourhood pins and then locked.
    const map = L.map(mapEl, {
      zoomControl: false,
      dragging: false,
      scrollWheelZoom: false,
      doubleClickZoom: false,
      touchZoom: false,
      boxZoom: false,
      keyboard: false,
      zoomSnap: 0.25,
      attributionControl: true,
    });

    const pinBounds = L.latLngBounds(neighbourhoods.map((hood) => hood.coords));
    function frameMap() {
      map.invalidateSize();
      map.setMinZoom(1);
      map.setMaxZoom(18);
      map.fitBounds(pinBounds, { padding: [48, 48], animate: false });
      const lockedZoom = map.getZoom();
      map.setMinZoom(lockedZoom);
      map.setMaxZoom(lockedZoom);
    }
    frameMap();
    window.addEventListener("resize", frameMap);

    // CARTO's keyless dark_all raster basemap (basemaps.cartocdn.com) and
    // Stadia Maps both require an API key as of September 2026. Standard
    // OpenStreetMap raster tiles are the last remaining truly free, keyless,
    // account-free raster tile source; a CSS filter on the tile pane (see
    // .leaflet-tile-pane above) recolors them to match the navy/gold design
    // system instead. Do not switch this tile URL — see CLAUDE.md → "Map
    // Component — Tile Layer Rule".
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: "abc",
      maxZoom: 19,
    }).addTo(map);

    let activeMarker: L.Marker | null = null;
    let activePopup: L.Popup | null = null;

    const reportDefault = document.getElementById("report-default");
    const reportActive = document.getElementById("report-active");
    const reportName = document.getElementById("report-name");
    const reportGpg = document.getElementById("report-gpg");
    const reportWqa = document.getElementById("report-wqa");
    const reportIssuesHeading = document.getElementById("report-issues-heading");
    const reportIssues = document.getElementById("report-issues");
    const reportCta = document.getElementById("report-cta");

    neighbourhoods.forEach((hood) => {
      const marker = L.marker(hood.coords, { icon: defaultIcon() }).addTo(map);

      // Hover tooltip — shows name and GPG on mouseover
      marker.bindTooltip(
        `<div class="map-hover-tooltip">
           <span class="tooltip-name">${hood.name}</span>
           <span class="tooltip-gpg">${hood.gpgRange} GPG</span>
         </div>`,
        {
          permanent: false,
          direction: "bottom",
          offset: [0, 8],
          opacity: 1,
          className: "map-tooltip-wrapper",
        },
      );

      marker.on("click", () => {
        marker.closeTooltip();
        if (activeMarker && activeMarker !== marker) {
          activeMarker.setIcon(defaultIcon());
        }
        if (activePopup) {
          map.closePopup(activePopup);
        }

        marker.setIcon(activeIcon());
        activeMarker = marker;

        activePopup = L.popup({
          closeButton: false,
          autoPan: false,
          className: "map-label-popup",
          offset: [0, -10],
        })
          .setLatLng(hood.coords)
          .setContent(`<strong>${hood.name}</strong>`)
          .openOn(map);

        if (reportDefault) reportDefault.style.display = "none";
        if (reportActive) reportActive.style.display = "block";
        if (reportName) reportName.textContent = hood.name;
        if (reportGpg) reportGpg.textContent = hood.gpgRange;
        if (reportWqa) reportWqa.innerHTML = `<div class="wqa-note">ℹ️ ${hood.wqaNote}</div>`;
        if (reportIssuesHeading) reportIssuesHeading.textContent = `Common issues in ${hood.name}:`;
        if (reportIssues) reportIssues.innerHTML = hood.issues.map((i) => `<li>${i}</li>`).join("");
        if (reportCta) reportCta.textContent = `Free Consultation for ${hood.name} →`;
      });
    });
  }
</script>
