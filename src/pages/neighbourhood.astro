---
import HomeLink from "../components/HomeLink.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import headerImage from "../assets/images/neighbourhood-header.webp";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Water Softener Service Areas in ${site.city}, ${site.stateAbbr}`}
  description={`Water softener service areas in ${site.city}, ${site.stateAbbr}. We serve all ${site.city} neighbourhoods and surrounding ${site.county} communities. Free water test included with every consultation.`}
>
  <PageHero
    breadcrumbs={[{ label: "Neighbourhoods" }]}
    heading={`Water Softener Service Areas in ${site.city}, ${site.stateAbbr}: ${site.neighbourhoods[0]}, ${site.neighbourhoods[1]} & More`}
    image={headerImage}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Round Rock" }}
  >
    <p slot="opening">
      {site.city} neighbourhoods share one {site.gpgLow}-{site.gpgHigh} GPG ({site.gpgLabel}) supply from {site.waterAuthority}.
      {" "}<HomeLink variant="plain" />
      {" "}provides water softener installation and service across every one of them, such as
      {" "}{site.neighbourhoods.join(", ")}, and surrounding {site.county} communities. Free in-home water test
      available across all service areas. Same day service. No obligation.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">

      <div class="section-header">
        <p>We install and service water softeners, such as salt-based and salt-free systems, throughout {site.city}, {site.stateAbbr}, and every neighbourhood shares the same {site.gpgLow}–{site.gpgHigh} GPG ({site.gpgLabel}) water from {site.waterSource}.</p>
      </div>
    </div>
  </section>

  <QuickFacts />

  {site.neighbourhoods.map((neighbourhood) => (
    <section class="section neighbourhood-section" id={neighbourhood.toLowerCase().replace(/\s+/g, "-")}>
      <div class="container">
        <h2>{neighbourhood}</h2>
        <p>
          {neighbourhood} homes receive {site.gpgLow}–{site.gpgHigh} GPG ({site.gpgLabel.toLowerCase()}) water, the same
          supply as the rest of {site.city}, sourced from {site.waterSource}. {site.waterAuthority} reports
          this reading holds for every {neighbourhood} address. We provide free water testing and same-week
          installation, so get a free quote for {neighbourhood} today.
        </p>
        <a class="btn btn-secondary btn-sm neighbourhood-cta" href="/quote/">Get a Free Water Softener Quote in Round Rock</a>
      </div>
    </section>
  ))}

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Looking for a Different Neighbourhood?</h2>
      <p>{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure across all of {site.city} and surrounding {site.county} — reach out for a free quote wherever you are.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Round Rock</a>
    </div>
  </section>

  <style>
    .neighbourhood-section:nth-of-type(odd) { background: var(--color-surface); }
    .neighbourhood-section h2 { margin-bottom: 8px; }
    /* Offsets the anchor-scroll target below the sticky site header (plus
       utility bar) so a deep link from the Locations nav dropdown doesn't
       land with the heading hidden underneath. */
    .neighbourhood-section { scroll-margin-top: 120px; }
    .neighbourhood-cta { margin-top: 16px; }
    .neighbourhood-cta:not(:hover) { color: var(--color-primary); border-color: var(--color-primary); }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
